{
  "name": "@latitudenpm/metrics",
  "version": "1.0.23",
  "description": "Reusable observability package — Prometheus metrics, health/readiness endpoints, HTTP middleware",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "test": "mocha --recursive --timeout 90000",
    "build": "npx babel src --out-dir dist",
    "build:dev": "npx babel src --out-dir dist --watch"
  },
  "keywords": [
    "metrics"
  ],
  "author": "Ravi N D",
  "license": "ISC",
  "dependencies": {
    "graphql": "16.14.0",
    "ip-range-check": "0.2.0",
    "mongoose": "8.24.0",
    "node-cron": "4.2.1",
    "opossum": "10.0.0",
    "prom-client": "15.1.0"
  },
  "devDependencies": {
    "@babel/cli": "7.23.0",
    "@babel/core": "7.23.0",
    "@babel/plugin-transform-runtime": "7.22.15",
    "@babel/preset-env": "7.22.20",
    "babel-loader": "8.3.0",
    "babel-polyfill": "6.26.0",
    "babel-preset-es2015": "6.24.1",
    "babel-preset-stage-0": "6.24.1"
  },
  "peerDependencies": {
    "express": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://gitlab.ezeefin.ai/ezee/microservices/npm-packages/microservice-metrics.git"
  }
}
